  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                bank_account_id,\n                transaction_reference,\n                transaction_date,\n                amount,\n                currency,\n                description,\n                metadata,\n                status,\n                journal_entry_id,\n                tenant_id\n            FROM transactions\n            WHERE bank_account_id = $1\n            AND tenant_id = $2\n            ORDER BY created_at DESC\n            OFFSET $3 LIMIT $4\n            ",
